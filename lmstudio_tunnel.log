ata: dict):\n25:     \"\"\"Логирует событие в файл\"\"\"\n26:     timestamp = datetime.now().isoformat()\n27:     entry = {\n28:         \"timestamp\": timestamp,\n29:         \"direction\": direction,\n30:         \"data\": data\n31:     }\n32:     with open(LOG_FILE, \"a\", encoding=\"utf-8\") as f:\n33:         f.write(json.dumps(entry, ensure_ascii=False) + \"\\n\")\n34:     \n35:     # Также выводим в консоль\n36:     print(f\"\\n{'='*80}\")\n37:     print(f\"[{direction}] {timestamp}\")\n38:     print(f\"{'='*80}\")\n39:     print(json.dumps(data, indent=2, ensure_ascii=False))\n40:     print(f\"{'='*80}\\n\")\n41: \n42: @app.api_route(\"/{path:path}\", methods=[\"GET\", \"POST\", \"PUT\", \"DELETE\", \"OPTIONS\", \"HEAD\", \"PATCH\"])\n43: async def tunnel(request: Request, path: str):\n44:     \"\"\"Туннелирует все запросы к LM Studio Net\"\"\"\n45:     \n46:     # Формируем URL назначения\n47:     target_url = urljoin(TARGET_BASE, path)\n48:     if request.query_params:\n49:         target_url += \"?\" + str(request.query_params)\n50:     \n51:     # Получаем тело запроса\n52:     body = await request.body()\n53:     body_str = body.decode(\"utf-8\") if body else None\n54:     \n55:     # Логируем входящий запрос\n56:     request_data = {\n57:         \"method\": request.method,\n58:         \"url\": str(request.url),\n59:         \"target_url\": target_url,\n60:         \"headers\": dict(request.headers),\n61:         \"body\": json.loads(body_str) if body_str else None\n62:     }\n63:     log_event(\"REQUEST\", request_data)\n64:     \n65:     # Делаем запрос к LM Studio Net\n66:     try:\n67:         response = requests.request(\n68:             method=request.method,\n69:             url=target_url,\n70:             headers={k: v for k, v in request.headers.items() if k.lower() not in [\"host\", \"content-length\"]},\n71:             data=body,\n72:             timeout=120,\n73:             stream=True\n74:         )\n75:         \n76:         # Получае